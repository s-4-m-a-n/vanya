# Copy to .env (repo root for docker compose; backend/.env for `uv run`).
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql+psycopg://digitalhunter:digitalhunter@localhost:5433/digitalhunter

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
MEDIA_URL_SECRET=change-me-media-secret

# --- Provider switches (local open-source default -> Google Cloud) ---
# local | gcs
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./var/media
# Empty = same-origin /media URLs (works behind the web dev proxy).
MEDIA_BASE_URL=
GCS_BUCKET=

# inprocess | pubsub
EVENTS_PROVIDER=inprocess
# Run in-process handlers in the background, like Pub/Sub on GCP.
EVENTS_INPROCESS_ASYNC=true
PUBSUB_TOPIC_PREFIX=dh.

# Photos larger than this are rejected (MB).
MAX_UPLOAD_MB=15

# --- AI: Gemini via OpenRouter locally -> Gemini on Vertex AI on GCP ---
# none | openrouter | vertex
LLM_PROVIDER=openrouter
# OpenRouter slug; the Vertex adapter drops the "google/" prefix.
LLM_MODEL=google/gemini-3-flash-preview
# minimal | low | medium | high (lower = faster IDs)
LLM_REASONING_EFFORT=low
# Max tokens per response (caps cost; reasoning counts toward it).
LLM_MAX_OUTPUT_TOKENS=4096
# Paste your key from https://openrouter.ai/keys (never commit it).
OPENROUTER_API_KEY=

# stub (deterministic fake) | llm (Gemini, using the LLM settings above)
SPECIES_ID_PROVIDER=llm
SPECIES_ID_TOP_K=3
# local (taxa table only) | gbif (validate names against GBIF and add new species)
TAXONOMY_RESOLVER=gbif

# --- Verification (PRD F3) ---
# none | gbif (GBIF occurrence counts as the regional commonness baseline)
OCCURRENCE_BASELINE=gbif
# Auto-accept only above this AI confidence for common species.
AUTO_ACCEPT_MIN_CONFIDENCE=0.85

# --- Analytics (PRD §9) ---
# postgres | bigquery
ANALYTICS_PROVIDER=postgres
BIGQUERY_DATASET=

# Vertex AI region for Gemini (global works for preview models).
GCP_LOCATION=global
GCP_PROJECT_ID=
